@model learning_platform.Areas.Admin.Models.DashboardStatsViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <h1 class="h3 mb-0 text-gray-800">Dashboard</h1>
    <p class="text-muted small">System overview and control metrics.</p>
</div>

<!-- Statistics Cards -->
<div class="row g-4 mb-4">
    <!-- Administrators Card -->
    <div class="col-xl-4 col-md-6">
        <div class="card card-custom h-100 border-start border-primary border-4 py-2">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Administrators</div>
                        <div class="h5 mb-0 font-weight-bold text-dark fs-2">@Model.TotalAdmins</div>
                    </div>
                    <div class="text-primary fs-1">
                        <i class="bi bi-shield-check"></i>
                    </div>
                </div>
                @if (User.IsInRole("SuperAdmin"))
                {
                    <div class="mt-3">
                        <a asp-controller="Users" asp-action="Admins" class="text-primary text-decoration-none small fw-bold">
                            Manage Admins <i class="bi bi-arrow-right-short"></i>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Teachers Card -->
    <div class="col-xl-4 col-md-6">
        <div class="card card-custom h-100 border-start border-success border-4 py-2">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Active Teachers</div>
                        <div class="h5 mb-0 font-weight-bold text-dark fs-2">@Model.TotalTeachers</div>
                    </div>
                    <div class="text-success fs-1">
                        <i class="bi bi-person-workspace"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <a href="#" class="text-success text-decoration-none small fw-bold">
                        Manage Teachers <i class="bi bi-arrow-right-short"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Students Card -->
    <div class="col-xl-4 col-md-6">
        <div class="card card-custom h-100 border-start border-info border-4 py-2">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Registered Students</div>
                        <div class="h5 mb-0 font-weight-bold text-dark fs-2">@Model.TotalStudents</div>
                    </div>
                    <div class="text-info fs-1">
                        <i class="bi bi-mortarboard"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <a href="#" class="text-info text-decoration-none small fw-bold">
                        Manage Students <i class="bi bi-arrow-right-short"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Welcome Panel -->
<div class="card card-custom p-4">
    <div class="card-body">
        <h3 class="fw-bold mb-3">Welcome to the Administration Portal</h3>
        <p class="text-secondary leading-relaxed">
            Use the sidebar navigation to manage user accounts, coordinate lecture schedules, review feedback from students, and generate lecture compliance reports. Use the stats panel above to keep track of current platform registration metrics.
        </p>
    </div>
</div>
