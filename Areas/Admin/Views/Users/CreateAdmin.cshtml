@model learning_platform.Areas.Admin.Models.CreateAdminViewModel

@{
    ViewData["Title"] = "Register Administrator";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <h1 class="h3 mb-0 text-gray-800">Register Administrator</h1>
    <p class="text-muted small">Create a new administrator or super administrator login account.</p>
</div>

<div class="row">
    <div class="col-xl-6 col-lg-8">
        <div class="card card-custom shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="m-0 font-weight-bold text-primary"><i class="bi bi-shield-plus me-2"></i> Account Registration</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateAdmin" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Email Field -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label font-weight-bold">Email Address</label>
                        <input asp-for="Email" class="form-control" placeholder="admin@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Password Field -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label font-weight-bold">Password</label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="Minimum 6 characters" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Confirm Password Field -->
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label font-weight-bold">Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirm your password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <!-- Role Dropdown Selection -->
                    <div class="mb-4">
                        <label asp-for="Role" class="form-label font-weight-bold">Role Assignment</label>
                        <select asp-for="Role" class="form-select">
                            <option value="Admin">Admin (Access to Teachers, Students, & Schedules)</option>
                            <option value="SuperAdmin">SuperAdmin (Full Permissions, Manage Administrators)</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Admins" class="btn btn-custom-secondary">Cancel</a>
                        <button type="submit" class="btn btn-custom-primary">Register Account</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
