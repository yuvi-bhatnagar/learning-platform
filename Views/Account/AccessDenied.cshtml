@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="alert alert-danger py-5 border-0 shadow-sm">
            <h1 class="display-4 text-danger mb-4"><i class="bi bi-shield-slash"></i> Access Denied</h1>
            <p class="lead">You do not have authorization or permissions to access this page.</p>
            <hr class="my-4">
            <p class="mb-4">If you believe this is an error, please contact a Super Administrator or log in with a different account.</p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Go to Home Page</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Log In</a>
            </div>
        </div>
    </div>
</div>
